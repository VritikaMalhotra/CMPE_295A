#!/bin/bash
# Written by `python -m testbed.run +experiment={experiment}` (local=false). One array task per configuration;
# each task starts its own llama-server and runs that configuration's pending episodes (resumable).
# report.sbatch runs once after the whole array (afterany) and writes the report.
# Walltime: Slurm sends USR1 3 minutes before the limit; the task stops the runner (finished episodes are
# already on disk), requeues itself and resumes where it stopped (spike S10). At most {max_requeue} requeues.
#SBATCH -J {job}
#SBATCH -p {partition}
#SBATCH --gres={gres}
#SBATCH -c 4
#SBATCH --mem=24G
#SBATCH -t {time}
#SBATCH --array=0-{n}%{max_conc}
#SBATCH -o {logdir}/%A_%a.out
#SBATCH --open-mode=append
#SBATCH --requeue
#SBATCH --signal=B:USR1@180
{account_line}
set -euo pipefail
cd {repo}
if [ -f scripts/hpc_env.sh ] && [ -d /scratch/cmpe295-bertin ]; then source scripts/hpc_env.sh; fi
source .venv/bin/activate
KEY=$(sed -n "$((SLURM_ARRAY_TASK_ID + 1))p" {cfg_list})
TASK="$SLURM_ARRAY_JOB_ID"_"$SLURM_ARRAY_TASK_ID"
echo "config $KEY task $TASK on $(hostname), restart ${{SLURM_RESTART_COUNT:-0}}, CUDA_VISIBLE_DEVICES=${{CUDA_VISIBLE_DEVICES:-unset}}"
nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader || true
requeue() {{
  echo "walltime near: stopping the runner and requeueing $TASK"
  kill -TERM "$PID" 2>/dev/null || true
  wait "$PID" || true
  if [ "${{SLURM_RESTART_COUNT:-0}}" -lt {max_requeue} ]; then scontrol requeue "$TASK"; else echo "requeue limit reached"; fi
  exit 0
}}
trap requeue USR1
python -m testbed.run +experiment={experiment} local=true only_config="$KEY" &
PID=$!
wait "$PID"
